{
  "name": "ieca-server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prestart": "node scripts/verify-production.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx scripts/seed-passwords.js",
    "alertas": "tsx scripts/enviar-alertas.js",
    "alertas:force": "tsx scripts/enviar-alertas.js --force",
    "email:prueba": "tsx scripts/enviar-email-prueba.js",
    "usuario:inicial": "tsx scripts/crear-usuario-inicial.js",
    "typecheck": "tsc --noEmit",
    "verify:prod": "node scripts/verify-production.js",
    "test": "tsx --import ./test/setup.js --test test/**/*.test.js",
    "test:integration": "tsx --test test/http.integration.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.30",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
